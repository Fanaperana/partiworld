// Wild animals. Everything about how they live is in `life`; genes start at
// the species average and drift with every generation, and each animal's
// brain learns from what works. Add a new animal by adding an entry here
// (or in your own mod): give it a sprite, a diet, and what it fears.
[
    CreatureDef(
        id: "core:rabbit",
        name: "Rabbit",
        sprite: SpriteDef(
            palette: {'b': "$fur", 'w': "#efe9de", 'e': "#2a2020"},
            rows: [
                ".b.b.",
                ".b.b.",
                "bbbbb",
                "bebeb",
                "bbbbb",
                ".bwb.",
            ],
        ),
        speed: 3.8,
        slots: {"fur": ["#9a8a76", "#b4a48c", "#7a6a58", "#c8bca8"]},
        life: LifeDef(
            tags: ["prey", "small"],
            diet: [Graze(matches: "tag:grazable", leaves: "core:dirt", energy: 1.0)],
            flees: ["predator"],
            size: 0.35,
            sight: 8.0,
            hunger: 0.05,
            lifespan_days: 10.0,
            adult_days: 1.5,
            litter: (2, 4),
            breed_every_hours: 30.0,
            herd: 0.2,
            cold_limit: -6.0,
            mutation: 0.07,
            max_population: 160,
            migrates: true,
            remains: [("core:meat", 1)],
        ),
    ),
    CreatureDef(
        id: "core:deer",
        name: "Deer",
        sprite: SpriteDef(
            palette: {'a': "#d8c8a4", 'B': "$fur", 'w': "#efe4d0", 'e': "#201818", 'l': "#3a2a1c"},
            rows: [
                "a.....a",
                ".a...a.",
                "..BBB..",
                "..eBe..",
                ".BBBBB.",
                ".BwBwB.",
                ".BBBBB.",
                ".BBBBB.",
                ".l...l.",
            ],
        ),
        speed: 3.6,
        slots: {"fur": ["#8a5a32", "#9c6a3c", "#7a4e2a", "#a8784a"]},
        life: LifeDef(
            tags: ["prey", "large_prey"],
            diet: [
                Graze(matches: "tag:grazable", leaves: "core:dirt", energy: 1.4),
                Browse(tags: ["bush"], energy: 2.0),
            ],
            flees: ["predator"],
            size: 1.1,
            sight: 12.0,
            hunger: 0.035,
            lifespan_days: 24.0,
            adult_days: 4.0,
            litter: (1, 2),
            breed_every_hours: 60.0,
            herd: 0.7,
            cold_limit: -14.0,
            mutation: 0.06,
            max_population: 80,
            migrates: true,
            remains: [("core:meat", 4), ("core:hide", 1)],
        ),
    ),
    CreatureDef(
        id: "core:wolf",
        name: "Wolf",
        sprite: SpriteDef(
            palette: {'G': "$fur", 'y': "#e8d040", 'n': "#1c1a1a"},
            rows: [
                "G.....G",
                "GG...GG",
                ".GGGGG.",
                ".GyGyG.",
                ".GGnGG.",
                ".GGGGG.",
                ".GGGGG.",
                "..GGG..",
                "...G...",
            ],
        ),
        speed: 4.0,
        slots: {"fur": ["#6a6a70", "#808088", "#4a4a50", "#9a958c"]},
        life: LifeDef(
            tags: ["predator"],
            diet: [Hunt(tags: ["prey"], energy: 0.8)],
            flees: [],
            size: 0.9,
            sight: 16.0,
            hunger: 0.03,
            lifespan_days: 28.0,
            adult_days: 3.0,
            litter: (1, 3),
            breed_every_hours: 96.0,
            herd: 0.6,
            cold_limit: -25.0,
            mutation: 0.06,
            max_population: 24,
            migrates: true,
            remains: [("core:meat", 2), ("core:hide", 1)],
