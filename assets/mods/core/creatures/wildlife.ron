// Wild animals. Everything about how they live is in `life`; genes start at
// the species average and drift with every generation, and each animal's
// brain learns from what works. Add a new animal by adding an entry here
// (or in your own mod): give it a sprite, a diet, and what it fears.
[
    CreatureDef(
        id: "core:rabbit",
        name: "Rabbit",
        sprite: SpriteDef(
            palette: {
                'f': "$fur", 'F': "$fur-", 'g': "$fur+",
                'i': "#d9a0a0", 'w': "#f2ece2", 'e': "#1e1818", 'n': "#c97878",
            },
            rows: [
                ".g.F.",
                ".i.i.",
                ".g.F.",
                "gfffF",
                "fefeF",
                "gwnwF",
                "gfffF",
                "gffFF",
                ".F.F.",
            ],
        ),
        speed: 3.8,
        slots: {"fur": ["#9a8a76", "#b4a48c", "#7a6a58", "#c8bca8"]},
        life: LifeDef(
            tags: ["prey", "small"],
            diet: [Graze(matches: "tag:grazable", leaves: "core:dirt", energy: 1.0)],
            flees: ["predator"],
            size: 0.35,
            sight: 8.0,
            hunger: 0.05,
            lifespan_days: 10.0,
            adult_days: 1.5,
            litter: (2, 4),
            breed_every_hours: 30.0,
            herd: 0.2,
            cold_limit: -6.0,
            mutation: 0.07,
            max_population: 160,
            migrates: true,
            remains: [("core:meat", 1)],
        ),
    ),
    CreatureDef(
        id: "core:deer",
        name: "Deer",
        sprite: SpriteDef(
            palette: {
                'f': "$fur", 'F': "$fur-", 'g': "$fur+",
                'A': "#e6dabb", 'a': "#b8a47e", 'w': "#f0e6d4",
                'e': "#1e1616", 'n': "#2a1e1a", 'l': "#3a2a1c",
            },
            rows: [
                "A.A...a.a",
                ".A.....a.",
                "..AgfFa..",
                ".gggfFFF.",
                "...efe...",
                "...gfF...",
                "...wnw...",
                "..gfffF..",
                ".gfwfwFF.",
                ".gfffFFF.",
                ".l.l.l.l.",
            ],
        ),
        speed: 3.6,
        slots: {"fur": ["#8a5a32", "#9c6a3c", "#7a4e2a", "#a8784a"]},
        life: LifeDef(
            tags: ["prey", "large_prey"],
            diet: [
                Graze(matches: "tag:grazable", leaves: "core:dirt", energy: 1.4),
                Browse(tags: ["bush"], energy: 2.0),
            ],
            flees: ["predator"],
            size: 1.1,
            sight: 12.0,
            hunger: 0.035,
            lifespan_days: 24.0,
            adult_days: 4.0,
            litter: (1, 2),
            breed_every_hours: 60.0,
            herd: 0.7,
            cold_limit: -14.0,
            mutation: 0.06,
            max_population: 80,
            migrates: true,
            remains: [("core:meat", 4), ("core:hide", 1)],
        ),
    ),
    CreatureDef(
        id: "core:wolf",
        name: "Wolf",
        sprite: SpriteDef(
            palette: {
                'f': "$fur", 'F': "$fur-", 'g': "$fur+",
                'c': "#d6d0c4", 'y': "#e8c838", 'n': "#161414", 'l': "#2a2628",
            },
            rows: [
                ".g.....F.",
                ".gg...FF.",
                ".ggfffFF.",
                ".gfyfyfF.",
                "..cfffF..",
                "...cnc...",
                "..gfffF..",
                ".gffcfFF.",
                ".gffffFF.",
                ".gfffFFFg",
                ".l.l.l.lg",
            ],
        ),
        speed: 4.0,
        slots: {"fur": ["#6a6a70", "#808088", "#4a4a50", "#9a958c"]},
        life: LifeDef(
            tags: ["predator"],
            diet: [Hunt(tags: ["prey"], energy: 0.8)],
            flees: [],
            size: 0.9,
            sight: 16.0,
            hunger: 0.03,
            lifespan_days: 28.0,
            adult_days: 3.0,
            litter: (1, 3),
            breed_every_hours: 96.0,
            herd: 0.6,
            cold_limit: -25.0,
