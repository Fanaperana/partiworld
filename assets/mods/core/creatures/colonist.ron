CreatureDef(
    id: "core:colonist",
    name: "Colonist",
    // Front view, lit from the top-left. `$slot-` is a shadow tone and
    // `$slot+` a highlight of that slot's colour.
    sprite: SpriteDef(
        palette: {
            'h': "$hair", 'H': "$hair-", 'j': "$hair+",
            's': "$skin", 'd': "$skin-", 'e': "#1e1820",
            'S': "$shirt", 'D': "$shirt-", 'L': "$shirt+",
            'p': "#3a3546", 'P': "#2a2632", 'b': "#2a1e16",
        },
        rows: [
            "...hhh...",
            "..hjjhH..",
            ".hjhhhhH.",
            ".hsssshH.",
            ".hsesedH.",
            "..ssssd..",
            "..LSSSD..",
            ".LLSSSDD.",
            ".LSSSSSD.",
            ".sppppPd.",
            "..pp.PP..",
            "..bb.bb..",
        ],
    ),
    speed: 3.2,
    names: ["Ada", "Bram", "Cleo", "Dov", "Edda", "Finn", "Greta", "Hiro", "Ines", "Joss", "Kai", "Lena", "Milo", "Nia", "Otto", "Pia", "Rune", "Suri", "Tove", "Ugo", "Vera", "Wim", "Yara", "Zed"],
    slots: {
        "hair": ["#2b1d14", "#5a3a1e", "#b07a3a", "#e0c070", "#1c1c1c", "#8a3b22", "#cfcfcf"],
        "skin": ["#f1c9a5", "#d9a47a", "#b07850", "#8a5a3a", "#5e3d27"],
        "shirt": ["#3f6fb5", "#b53f3f", "#3fa060", "#c09030", "#7a4fb0", "#d06a2a", "#408a8a"],
    },
    // Hunger, sleep and warmth. A full meal lasts a day; they need sleep
    // about every 18 hours, and get cold below 12 C.
    needs: NeedsDef(food_days: 1.0, awake_days: 0.75, comfort: (12.0, 32.0), toughness: 1.0),
)
