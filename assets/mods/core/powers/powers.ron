// God powers. Each is a brush made of effects; `ring` limits an effect to
// part of the brush (0 = centre, 1 = edge). Add your own in any mod's
// `powers/` folder. Effects: Paint, Ignite, Place, Spawn, Weather, Script, Flash.
[
    PowerDef(id: "core:lightning", name: "Lightning", category: "Sky", radius: 2,
        description: "A bolt from the sky. Sets things on fire.",
        effects: [
            Flash,
            Ignite(chance: 1.0, ring: (0.0, 1.0)),
            Paint(layer: Floor, set: "core:ash", onto: Some("tag:soil"), chance: 0.6),
        ]),
    PowerDef(id: "core:rain", name: "Rain cloud", category: "Sky", radius: 4,
        description: "Starts rain (or snow when it's freezing).",
        effects: [Weather(id: "core:rain")]),
    PowerDef(id: "core:storm", name: "Thunderstorm", category: "Sky", radius: 4,
        description: "Wind, heavy rain and lightning weather.",
        effects: [Weather(id: "core:storm")]),
    PowerDef(id: "core:clear_sky", name: "Clear sky", category: "Sky", radius: 4,
        description: "Clears the weather.",
        effects: [Weather(id: "core:clear")]),
    PowerDef(id: "core:blizzard", name: "Blizzard", category: "Sky", radius: 4,
        description: "Bitter cold and snow.",
        effects: [Weather(id: "core:blizzard")]),

    PowerDef(id: "core:meteor", name: "Meteor", category: "Destruction", radius: 14,
        description: "Blasts a crater with a molten core and a rocky rim.",
        effects: [
            Flash,
            Paint(layer: Overlay, set: "none", ring: (0.0, 1.1)),
            Paint(layer: Solid, set: "none", ring: (0.0, 0.85)),
            Paint(layer: Floor, set: "core:basalt", ring: (0.0, 0.85)),
            Paint(layer: Floor, set: "core:lava", ring: (0.0, 0.35)),
            Paint(layer: Solid, set: "core:stone", ring: (0.85, 1.05), chance: 0.7),
            Ignite(chance: 0.5, ring: (1.0, 1.6)),
            Paint(layer: Floor, set: "core:ash", onto: Some("tag:soil"), ring: (0.85, 1.5), chance: 0.5),
        ]),
    PowerDef(id: "core:earthquake", name: "Earthquake", category: "Destruction", radius: 40,
        description: "Shakes buildings and rocks apart and cracks the ground.",
        effects: [
            Paint(layer: Solid, set: "none", onto: Some("tag:built"), chance: 0.18),
            Paint(layer: Solid, set: "none", onto: Some("tag:mineable"), chance: 0.08),
            Paint(layer: Overlay, set: "none", onto: Some("tag:roof"), chance: 0.25),
            Paint(layer: Floor, set: "core:pit", onto: Some("tag:soil"), chance: 0.02),
        ]),
    PowerDef(id: "core:volcano", name: "Lava", category: "Destruction", radius: 5, continuous: true,
        description: "Pour lava. It flows, burns, and cools into basalt.",
        effects: [Paint(layer: Solid, set: "none"), Paint(layer: Floor, set: "core:lava")]),
    PowerDef(id: "core:firestorm", name: "Firestorm", category: "Destruction", radius: 10,
        description: "Sets everything flammable in the area alight.",
        effects: [Ignite(chance: 0.35)]),

    PowerDef(id: "core:flood", name: "Water", category: "Land", radius: 6, continuous: true,
        description: "Pour water.",
        effects: [Paint(layer: Solid, set: "none", onto: Some("tag:built")), Paint(layer: Floor, set: "core:water")]),
    PowerDef(id: "core:dig", name: "Dig", category: "Land", radius: 4, continuous: true,
        description: "Dig pits and channels. Water nearby flows in.",
        effects: [Paint(layer: Solid, set: "none"), Paint(layer: Floor, set: "core:pit")]),
    PowerDef(id: "core:raise", name: "Raise rock", category: "Land", radius: 5, continuous: true,
        description: "Push up rock.",
        effects: [Paint(layer: Overlay, set: "none"), Paint(layer: Solid, set: "core:stone")]),
    PowerDef(id: "core:fertilize", name: "Fertilize", category: "Land", radius: 12,
        description: "Grass, flowers and young trees spring up.",
        effects: [
            Paint(layer: Floor, set: "core:grass", onto: Some("tag:soil")),
            Paint(layer: Floor, set: "core:grass", onto: Some("core:ash")),
            Paint(layer: Floor, set: "core:grass", onto: Some("core:sand"), chance: 0.6),
            Paint(layer: Floor, set: "core:flower_red", onto: Some("core:grass"), chance: 0.01),
            Paint(layer: Floor, set: "core:flower_yellow", onto: Some("core:grass"), chance: 0.01),
            Place(object: "core:oak_sapling", count: 2),
            Place(object: "core:berry_sprout", count: 1),
        ]),
    PowerDef(id: "core:freeze", name: "Freeze", category: "Land", radius: 10,
        description: "Turns water to ice and puts out fires.",
        effects: [
            Paint(layer: Floor, set: "core:ice", onto: Some("core:water")),
            Paint(layer: Floor, set: "core:deep_ice", onto: Some("core:deep_water")),
            Paint(layer: Floor, set: "core:ash", onto: Some("core:fire")),
            Paint(layer: Solid, set: "none", onto: Some("core:fire")),
            Paint(layer: Overlay, set: "none", onto: Some("core:fire")),
            Paint(layer: Floor, set: "core:basalt", onto: Some("tag:lava")),
        ]),
]
