        break_fraction: 0.5,
        build: BuildDef(cost: [("core:wood", 1)], work: 40, category: "Roofs"),
    ),
    ObjectDef(
        id: "core:bed",
        name: "Bed",
        tags: ["furniture", "bed", "flammable"],
        anchor: Tile,
        shape: Pattern(
            palette: {'P': "core:plank_dark", 'c': "core:bed_cloth", 'o': "core:bed_pillow"},
            layers: [PatternLayer(layer: Solid, rows: [
